<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Translucent adaptive deep teal glass surface:
         Subtle petrol blue-green glass overlay letting underlying wallpaper
         colors and textures show through with a calm, premium atmosphere -->
    <gradient
        android:angle="270"
        android:startColor="#A6102A2D"
        android:endColor="#BF0A1C1E"
        android:type="linear" />
    <corners android:radius="20dp" />
    <!-- Subtle frosted glass rim highlight -->
    <stroke
        android:width="1dp"
        android:color="#2EFFFFFF" />
</shape>
