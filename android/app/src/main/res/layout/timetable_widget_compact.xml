<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Top Bar: Status Badge + Full Day Name -->
    <RelativeLayout
        android:id="@+id/widget_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Full Day Name: Always on ONE line pinned top-right -->
        <TextView
            android:id="@+id/widget_day_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:ellipsize="none"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Thursday"
            android:textColor="#B7D7D5"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Status Badge: Constrained to left of day name -->
        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/widget_day_text"
            android:background="@drawable/widget_badge_now"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:text="NOW"
            android:textColor="#99F6E4"
            android:textSize="9sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Primary Current Class Section -->
    <LinearLayout
        android:id="@+id/widget_primary_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical">

        <!-- Course Title -->
        <TextView
            android:id="@+id/widget_course_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Data Structures"
            android:textColor="#F4FAFA"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Details Row: Course Code & Room -->
        <LinearLayout
            android:id="@+id/widget_details_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_course_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:text="24CSEN2001"
                android:textColor="#8FAEAD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  •  "
                android:textColor="#5A7A79"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="📍 ICT / 617"
                android:textColor="#48D1C7"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Time Row -->
        <TextView
            android:id="@+id/widget_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:singleLine="true"
            android:text="🕒 08:00 – 08:50"
            android:textColor="#C7DEDD"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Subtle Horizontal Divider -->
    <LinearLayout
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:background="#20B7D7D5"
        android:orientation="horizontal" />

    <!-- Secondary Next Class Section -->
    <LinearLayout
        android:id="@+id/widget_next_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <!-- Next Badge Pill -->
        <TextView
            android:id="@+id/widget_next_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_badge_next_label"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:text="Next"
            android:textColor="#99F6E4"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- Next Class Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Next Course Title -->
            <TextView
                android:id="@+id/widget_next_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Object Oriented Programming"
                android:textColor="#E0F2F1"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Next Code & Room -->
            <LinearLayout
                android:id="@+id/widget_next_details_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_next_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="24CSEN1011"
                    android:textColor="#8FAEAD"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_next_separator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  "
                    android:textColor="#5A7A79"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_next_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="📍 ICT / 505"
                    android:textColor="#48D1C7"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Next Time -->
            <TextView
                android:id="@+id/widget_next_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="🕒 09:00 – 09:50"
                android:textColor="#8FAEAD"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
